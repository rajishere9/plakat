# Plakat server configuration. Copy to .env (read by `npm run dev -w @plakat/server`
# from the current directory or the repo root, and by docker compose). Variables
# already set in the environment take precedence over .env.

# --- HTTP ---------------------------------------------------------------------
# Port and interface to listen on.
PORT=8787
HOST=0.0.0.0
# Public base URL of this instance, e.g. https://plakat.example.com (informational; logged at startup).
PUBLIC_URL=
# Comma-separated origins allowed via CORS. Leave empty when the SPA is served by
# this server or proxied by the Vite dev server (same origin, no CORS needed).
CORS_ORIGIN=
# Max JSON request body in MiB (documents, template imports, brand kits). Uploads
# are capped separately at 25 MiB, thumbnails at 2 MiB.
MAX_BODY_MB=40
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Database -----------------------------------------------------------------
# PostgreSQL connection string. When unset, an embedded PGlite (WASM Postgres)
# database is used at $DATA_DIR/pglite: zero-config local development.
# DATABASE_URL=postgres://plakat:plakat@localhost:5432/plakat
DATABASE_URL=
# Only when DATABASE_URL is unset: "memory" for a throwaway in-memory database,
# or a directory for the PGlite files (default $DATA_DIR/pglite).
PGLITE=

# --- Storage --------------------------------------------------------------------
# Root for local state (relative paths resolve against the working directory).
DATA_DIR=./data
# Uploaded and imported images, stored as <sha256>.<ext> (default $DATA_DIR/uploads).
UPLOAD_DIR=
# Directory scanned recursively for built-in *.plakat.json templates at startup
# (default <repo>/templates).
TEMPLATES_DIR=
# Built SPA (apps/web/dist) to serve with index.html fallback. Unset in development
# (Vite on :5173 proxies /api and /uploads to this server).
WEB_DIST=

# --- Asset providers --------------------------------------------------------------
# Openverse works anonymously (lower rate limits, 20 results per page, 240 deep).
# With API credentials (https://api.openverse.org/v1/#tag/auth) the server obtains
# an OAuth client-credentials token.
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
# Override the Openverse API base (mirrors/testing).
OPENVERSE_API_URL=https://api.openverse.org

# --- docker compose only ------------------------------------------------------------
# Password of the bundled Postgres (keep it URL-safe: it is embedded in DATABASE_URL).
POSTGRES_PASSWORD=plakat
# Host port published by docker compose.
PLAKAT_PORT=8787
