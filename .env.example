# Plakat server configuration. Copy to .env.
#
# - `npm run dev` / `npm run dev -w @plakat/server` / `npm start` read .env from the
#   current directory or the repo root. Variables already set in the environment
#   take precedence over .env.
# - `docker compose` reads .env only to fill ${...} in docker-compose.yml. It forwards
#   PUBLIC_URL, ALLOWED_HOSTS, BASIC_AUTH, CORS_ORIGIN, MAX_BODY_MB, LOG_LEVEL,
#   OPENVERSE_* and the "docker compose only" variables below; the container's PORT,
#   HOST, DATABASE_URL, DATA_DIR and UPLOAD_DIR are fixed in docker-compose.yml.
#
# SECURITY: Plakat has no user accounts. Anyone who can reach the server can read,
# change and delete every design, template and brand kit. Keep it on loopback, or
# put it behind an authenticating reverse proxy (or at least set BASIC_AUTH).

# --- HTTP ---------------------------------------------------------------------
# Port and interface to listen on. The default 127.0.0.1 accepts local connections
# only; 0.0.0.0 listens on every interface (the Docker image sets it).
PORT=8787
HOST=127.0.0.1
# Public base URL of this instance, e.g. https://plakat.example.com. Logged at
# startup; its host name is accepted in the Host header and its origin may send
# write requests.
PUBLIC_URL=
# Host names (comma separated) accepted in the Host header, besides localhost, IP
# addresses, single-label names (e.g. "nas") and *.local / *.localhost / *.internal /
# *.home.arpa. Other names are refused with 403 to block DNS-rebinding attacks.
# A leading dot matches subdomains (".example.com"); "*" disables the check.
ALLOWED_HOSTS=
# Optional shared login: "user:password" turns on HTTP Basic auth for everything
# except /api/health. Use HTTPS (a reverse proxy) when it crosses a network.
BASIC_AUTH=
# Comma-separated origins allowed via CORS (and allowed to send write requests).
# Leave empty when the SPA is served by this server or proxied by the Vite dev server
# (same origin, no CORS needed). Cross-site writes from other origins are refused.
CORS_ORIGIN=
# Max JSON request body in MiB (documents, template imports, brand kits). Uploads
# are capped separately at 25 MiB, thumbnails at 2 MiB.
MAX_BODY_MB=40
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Database -----------------------------------------------------------------
# PostgreSQL connection string. When unset, an embedded PGlite (WASM Postgres)
# database is used at $DATA_DIR/pglite: zero-config local development.
# DATABASE_URL=postgres://plakat:plakat@localhost:5432/plakat
DATABASE_URL=
# Only when DATABASE_URL is unset: "memory" for a throwaway in-memory database,
# or a directory for the PGlite files (default $DATA_DIR/pglite).
PGLITE=

# --- Storage --------------------------------------------------------------------
# Root for local state (relative paths resolve against the working directory).
DATA_DIR=./data
# Uploaded and imported images, stored as <sha256>.<ext> (default $DATA_DIR/uploads).
UPLOAD_DIR=
# Directory scanned recursively for built-in *.plakat.json templates at startup
# (default <repo>/templates).
TEMPLATES_DIR=
# Built SPA (apps/web/dist) to serve with index.html fallback. Unset in development
# (Vite on :5173 proxies /api and /uploads to this server).
WEB_DIST=

# --- Asset providers --------------------------------------------------------------
# Openverse works anonymously (lower rate limits, 20 results per page, 240 deep).
# With API credentials (https://api.openverse.org/v1/#tag/auth) the server obtains
# an OAuth client-credentials token.
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
# Override the Openverse API base (mirrors/testing).
OPENVERSE_API_URL=https://api.openverse.org

# --- docker compose only ------------------------------------------------------------
# Password of the bundled Postgres (keep it URL-safe: it is embedded in DATABASE_URL).
POSTGRES_PASSWORD=plakat
# Host interface and port published by docker compose (127.0.0.1 = this machine only).
PLAKAT_BIND=0.0.0.0
PLAKAT_PORT=8787
