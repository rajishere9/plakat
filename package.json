{
  "name": "plakat",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hostable, template-driven design editor (Canva-style) built on React, Konva, Zustand and Postgres.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @plakat/web",
    "start": "npm run start -w @plakat/server",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "templates:build": "tsx templates/scripts/build-templates.ts",
    "templates:check": "tsx templates/scripts/build-templates.ts --check"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
