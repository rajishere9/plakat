# Keep the build context small and never ship local state or secrets.
.git
.github
**/node_modules
**/dist
**/coverage
**/test-results
**/playwright-report
**/*.log
**/.DS_Store
# Env files at any depth (the dev server also reads apps/server/.env).
**/.env
**/.env.*
!**/.env.example
data
**/data/pglite
**/data/uploads
apps/server/uploads
graphify-out
